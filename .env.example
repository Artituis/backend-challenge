# Local development only. Inside Compose the hostname is postgres.
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wagering:wagering-local@localhost:5432/wagering
# Dedicated disposable database: integration tests drop/recreate only their own schema.
TEST_DATABASE_URL=postgresql://wagering:wagering-local@localhost:5432/wagering_test
