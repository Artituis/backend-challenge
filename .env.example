# Local development only. Inside Compose the hostname is postgres.
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql://wagering:wagering-local@localhost:5432/wagering
# Dedicated disposable database: integration tests drop/recreate only their own schema.
# Leave both TEST_* unset to let test:integration/test:concurrency/test:load provision disposable containers.
# TEST_DATABASE_URL=postgresql://wagering:wagering-local@localhost:5432/wagering_test
# TEST_SQS_ENDPOINT=http://localhost:4566

# LocalStack; use real IAM credentials/roles and omit SQS_ENDPOINT in AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_MAX_RECEIVES=5
SQS_VISIBILITY_SECONDS=60
CONSUMER_CONCURRENCY=4
OUTBOX_CONCURRENCY=2
PENDING_REFERENCE_TTL_MS=86400000
HTTP_PORT=3000
PORT=3000
WORKER_HEALTH_PORT=3001
