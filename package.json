    "db:pending": "bun src/infrastructure/persistence/migrate.ts pending"
  },
  "devDependencies": {
    "@types/bun": "1.3.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
