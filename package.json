{
  "name": "distributed-wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:worker": "bun src/worker.ts",
    "sqs:provision": "bun src/infrastructure/messaging/provision.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:ci": "bun scripts/integration.ts --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
    "test:integration": "bun scripts/test-environment.ts integration",
    "test:concurrency": "bun scripts/test-environment.ts concurrency",
    "test:load": "bun scripts/test-environment.ts load",
    "test:unit": "bun test tests/domain tests/application tests/messaging tests/observability tests/http tests/validation",
    "prepare": "bun scripts/prepare.ts",
    "lint": "bun node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "bun node_modules/eslint/bin/eslint.js . --fix --max-warnings=0",
    "format": "bun node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "bun node_modules/prettier/bin/prettier.cjs --check .",
    "lint-staged": "bun node_modules/lint-staged/bin/lint-staged.js",
    "commitlint": "bun node_modules/@commitlint/cli/cli.js",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "db:migrate": "bun src/infrastructure/persistence/migrate.ts up",
    "db:rollback": "bun src/infrastructure/persistence/migrate.ts down",
    "db:pending": "bun src/infrastructure/persistence/migrate.ts pending"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.2",
    "@types/express": "5.0.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1166.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
