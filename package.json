{
  "name": "distributed-wagering-processor",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun test tests/integration",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/infrastructure/persistence/migrate.ts up",
